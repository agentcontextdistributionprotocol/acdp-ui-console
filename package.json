{
  "name": "acdp-ui-console",
  "version": "0.1.0",
  "private": true,
  "description": "Next.js orchestration and observability console for the Agent Context Distribution Protocol (ACDP).",
  "scripts": {
    "dev": "next dev",
    "dev:demo": "NEXT_PUBLIC_ACDP_UI_DEMO_MODE=true next dev",
    "dev:real": "NEXT_PUBLIC_ACDP_UI_DEMO_MODE=false next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "dependencies": {
    "@agentcontextdistributionprotocol/acdp-wasm": "^0.8.1",
    "@tanstack/react-query": "^5.101.4",
    "@xyflow/react": "^12.11.2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-config-next": "^16.3.3",
    "jsdom": "^30.0.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
